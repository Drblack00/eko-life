# === Èkó Life — environment template (NO real secrets) ===
# Copy to .env for local dev. Never commit a real .env.

PORT=3000
# Long random string in production (Render auto-generates via render.yaml)
SESSION_SECRET=change-me-to-a-long-random-string
# Set to a Postgres connection string in production; leave empty for local SQLite
DATABASE_URL=
# Public stats seed (optional)
# SEED_VISITS=0
